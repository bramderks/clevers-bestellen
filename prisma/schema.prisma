generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vestiging {
  id String @id @default(cuid())

  naam String @unique
  code String @unique

  actief Boolean @default(true)

  aangemaakt DateTime @default(now())
  gewijzigd  DateTime @updatedAt

  @@index([actief])
}

model Gebruiker {
  id String @id @default(cuid())

  naam String

  email String @unique

  wachtwoordHash String?

  actief Boolean @default(true)

  laatsteLogin DateTime?

  aangemaakt    DateTime       @default(now())
  gewijzigd     DateTime       @updatedAt
  gebruikerRols GebruikerRol[]

  @@index([actief])
}

model Rol {
  id String @id @default(cuid())

  naam String @unique

  omschrijving String?

  aangemaakt    DateTime       @default(now())
  gebruikerRols GebruikerRol[]
}

model GebruikerRol {
  id String @id @default(cuid())

  gebruikerId String
  rolId       String

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
  rol       Rol       @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@unique([gebruikerId, rolId])
}

model Instelling {
  id String @id @default(cuid())

  sleutel String @unique

  waarde String

  omschrijving String?

  aangemaakt DateTime @default(now())
  gewijzigd  DateTime @updatedAt
}

model AuditLog {
  id String @id @default(cuid())

  gebruikerId String?

  actie String

  entiteit String

  entiteitId String?

  details Json?

  aangemaakt DateTime @default(now())

  @@index([actie])
  @@index([entiteit])
  @@index([aangemaakt])
}

model Bestelling {
  id         Int      @id @default(autoincrement())
  datum      DateTime
  vestiging  String
  medewerker String?
  type       String
  opmerking  String?
  aangemaakt DateTime @default(now())

  regels BestellingRegel[]
}

model BestellingRegel {
  id Int @id @default(autoincrement())

  bestellingId Int
  bestelling   Bestelling @relation(fields: [bestellingId], references: [id], onDelete: Cascade)

  productId   String
  productNaam String

  geteld  Int
  buffer  Int
  besteld Int

  bestelGroep String
}

model Week {
  id String @id @default(cuid())

  vestiging String
  jaar      Int
  week      Int

  afgesloten   Boolean   @default(false)
  afgeslotenOp DateTime?

  aangemaakt DateTime @default(now())

  taken WeekTaak[]

  @@unique([vestiging, jaar, week])
  @@index([vestiging])
  @@index([jaar, week])
  @@index([afgesloten])
}

model WeekTaak {
  id String @id @default(cuid())

  weekId String
  week   Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)

  categorie String
  taak      String

  voltooid   Boolean   @default(false)
  naam       String?
  voltooidOp DateTime?

  aangemaakt DateTime @default(now())

  @@index([weekId])
  @@index([categorie])
  @@index([voltooid])
}

model Medewerker {
  id String @id @default(cuid())

  voornaam   String
  achternaam String

  naam String

  email    String?
  telefoon String?

  vestiging String

  actief Boolean @default(true)

  kleur String @default("#2563eb")

  functie String? // Medewerker, Floormanager, Bedrijfsleider

  uurloon Decimal? @db.Decimal(6, 2)

  contractUren Int?

  datumInDienst DateTime?

  geboortedatum DateTime?

  pushToken String?

  opmerkingen String?

  aangemaakt DateTime @default(now())

  beschikbaarheden Beschikbaarheid[]
  diensten         Dienst[]
  uren             UurRegistratie[]

  @@index([vestiging])
  @@index([actief])
  @@index([functie])
}

model Beschikbaarheid {
  id String @id @default(cuid())

  medewerkerId String
  medewerker   Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)

  weekdag Int

  beschikbaar Boolean @default(true)

  vanaf String?
  tot   String?

  @@index([medewerkerId])
}

model Dienst {
  id String @id @default(cuid())

  medewerkerId String
  medewerker   Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)

  datum DateTime

  begintijd String
  eindtijd  String

  vestiging String

  functie String?

  aangemaakt DateTime @default(now())

  urenregistratie UurRegistratie?

  @@index([datum])
  @@index([vestiging])
  @@index([medewerkerId])
}

model UurRegistratie {
  id String @id @default(cuid())

  dienstId String @unique
  dienst   Dienst @relation(fields: [dienstId], references: [id], onDelete: Cascade)

  medewerkerId String
  medewerker   Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)

  geplandeStart String
  geplandeEinde String

  gewerkteStart String?
  gewerkteEinde String?

  pauze Int @default(0)

  opmerking String?

  goedgekeurd Boolean @default(false)

  @@index([medewerkerId])
}
