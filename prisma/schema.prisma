generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bestelling {
  id         Int                @id @default(autoincrement())
  datum      DateTime
  vestiging  String
  type       String
  aangemaakt DateTime           @default(now())

  regels     BestellingRegel[]
}

model BestellingRegel {
  id           Int          @id @default(autoincrement())

  bestellingId Int
  bestelling   Bestelling   @relation(fields: [bestellingId], references: [id], onDelete: Cascade)

  productId    String
  productNaam  String

  geteld       Int
  buffer       Int
  besteld      Int

  bestelGroep  String
}