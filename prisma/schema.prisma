generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bestelling {
  id          Int                @id @default(autoincrement())
  datum       DateTime
  vestiging   String
  medewerker  String?
  type        String
  aangemaakt  DateTime           @default(now())

  regels      BestellingRegel[]
}

model BestellingRegel {
  id            Int          @id @default(autoincrement())

  bestellingId  Int
  bestelling    Bestelling   @relation(fields: [bestellingId], references: [id], onDelete: Cascade)

  productId     String
  productNaam   String

  geteld        Int
  buffer        Int
  besteld       Int

  bestelGroep   String
}
model Week {
  id         String      @id @default(cuid())
  vestiging  String
  jaar       Int
  week       Int
  aangemaakt DateTime    @default(now())

  taken       WeekTaak[]

  @@unique([vestiging, jaar, week])
}

model WeekTaak {
  id          String    @id @default(cuid())
  weekId      String

  categorie   String
  taak        String

  voltooid    Boolean   @default(false)

  naam        String?
  voltooidOp  DateTime?

  week Week @relation(fields: [weekId], references: [id], onDelete: Cascade)
}