generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ======================================================
/// PLATFORM
/// ======================================================

model Vestiging {
  id String @id @default(cuid())

  code String @unique
  naam String @unique

  actief Boolean @default(true)

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  gebruikers Gebruiker[]
  medewerkers Medewerker[]
  diensten Dienst[]

  bestellingen Bestelling[]
  weken Week[]

  voorraadMutaties VoorraadMutatie[]

  productBuffers ProductBuffer[]

  documenten Document[]

  instellingen VestigingInstelling[]
  leverancierBestellingen LeverancierBestelling[]
  voorraadTellingen VoorraadTelling[]
  aiAdviezen AIAdvies[]
  importTaken ImportTaak[]
  dashboardMeldingen DashboardMelding[]
  dagAfsluitingen DagAfsluiting[]
  leveringen Levering[]
  werkLijsten WerkLijst[]
  rapporten Rapport[]
  taken Taak[]
  activiteiten Activiteit[]

  @@index([actief])
}

model Gebruiker {
  id String @id @default(cuid())

  naam String

  email String @unique

  wachtwoordHash String?

  actief Boolean @default(true)

  laatsteLoginOp DateTime?

  vestigingId String?
  vestiging Vestiging? @relation(fields: [vestigingId], references: [id], onDelete: SetNull)

  medewerker Medewerker?

  rollen GebruikerRol[]

  auditLogs AuditLog[]

  notificaties Notificatie[]

  documenten Document[]

  goedgekeurdeUurRegistraties UurRegistratie[]
  bestellingen Bestelling[]
  voltooideWeekTaken WeekTaak[]
  voorraadMutatiesAlsGebruiker VoorraadMutatie[]
  dashboardFavorieten DashboardFavoriet[]
  dashboardWidgets DashboardWidget[]
  loginSessies LoginSessie[]
  apiLogs ApiLog[]
  leverancierBestellingen LeverancierBestelling[]
  voorraadTellingen VoorraadTelling[]
  aiAdviezen AIAdvies[]
  importTaken ImportTaak[]
  exportTaken ExportTaak[]
  dagAfsluitingen DagAfsluiting[]
  gecontroleerdeLeveringen Levering[]
  gewijzigdeConfiguraties SysteemConfiguratie[]
  aangemaakteRapporten Rapport[]
  rapportUitvoeringen RapportUitvoering[]
  activiteiten Activiteit[]
  opgeslagenFilters OpgeslagenFilter[]
  favorieten Favoriet[]
  aangemaakteTaken Taak[] @relation("TaakAangemaaktDoor")
  toegewezenTaken Taak[] @relation("TaakToegewezenAan")

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([email])
  @@index([vestigingId])
  @@index([actief])
}

model Rol {
  id String @id @default(cuid())

  naam String @unique

  omschrijving String?

  gebruikers GebruikerRol[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt
}

model GebruikerRol {
  id String @id @default(cuid())

  gebruikerId String
  rolId String

  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  rol Rol @relation(fields: [rolId], references: [id], onDelete: Cascade)

  aangemaaktOp DateTime @default(now())

  @@unique([gebruikerId, rolId])

  @@index([gebruikerId])
  @@index([rolId])
}

model Instelling {
  id String @id @default(cuid())

  sleutel String @unique

  waarde String

  categorie String?

  omschrijving String?

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt
}

model VestigingInstelling {
  id String @id @default(cuid())

  vestigingId String
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  sleutel String

  waarde String

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@unique([vestigingId, sleutel])

  @@index([vestigingId])
}

model AuditLog {
  id String @id @default(cuid())

  gebruikerId String?
  gebruiker Gebruiker? @relation(fields: [gebruikerId], references: [id], onDelete: SetNull)

  actie String

  entiteit String

  entiteitId String?

  details Json?

  ipAdres String?

  userAgent String?

  aangemaaktOp DateTime @default(now())

  @@index([gebruikerId])
  @@index([entiteit])
  @@index([actie])
  @@index([aangemaaktOp])
}
/// ======================================================
/// HR
/// ======================================================

model Functie {
  id String @id @default(cuid())

  naam String @unique

  omschrijving String?

  kleur String?

  actief Boolean @default(true)

  medewerkers Medewerker[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([actief])
}

model Medewerker {
  id String @id @default(cuid())

  vestigingId String
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Restrict)

  gebruikerId String? @unique
  gebruiker Gebruiker? @relation(fields: [gebruikerId], references: [id], onDelete: SetNull)

  functieId String?
  functie Functie? @relation(fields: [functieId], references: [id], onDelete: SetNull)

  personeelsnummer String? @unique

  voornaam String
  tussenvoegsel String?
  achternaam String

  naam String

  email String?
  telefoon String?

  kleur String @default("#2563eb")

  uurloon Decimal? @db.Decimal(8,2)

  contractUren Decimal? @db.Decimal(5,2)

  datumInDienst DateTime?
  datumUitDienst DateTime?

  geboortedatum DateTime?

  pushToken String?

  opmerkingen String?

  actief Boolean @default(true)

  beschikbaarheden Beschikbaarheid[]
  diensten Dienst[]
  urenregistraties UurRegistratie[]
  werkLijstUitvoeringen WerkLijstUitvoering[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([vestigingId])
  @@index([functieId])
  @@index([actief])
  @@index([achternaam])
}

model Beschikbaarheid {
  id String @id @default(cuid())

  medewerkerId String
  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)

  weekdag Int

  beschikbaar Boolean @default(true)

  vanaf String?
  tot String?

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@unique([medewerkerId, weekdag])

  @@index([medewerkerId])
}

model Dienst {
  id String @id @default(cuid())

  vestigingId String
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Restrict)

  medewerkerId String
  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)

  datum DateTime

  begintijd String
  eindtijd String

  pauzeMinuten Int @default(0)

  opmerkingen String?

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  urenregistratie UurRegistratie?

  @@index([datum])
  @@index([vestigingId])
  @@index([medewerkerId])
}

model UurRegistratie {
  id String @id @default(cuid())

  dienstId String @unique
  dienst Dienst @relation(fields: [dienstId], references: [id], onDelete: Cascade)

  medewerkerId String
  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)

  geplandeStart DateTime
  geplandeEinde DateTime

  werkelijkeStart DateTime?
  werkelijkeEinde DateTime?

  pauzeMinuten Int @default(0)

  goedgekeurd Boolean @default(false)

  goedgekeurdDoorId String?
  goedgekeurdDoor Gebruiker? @relation(fields: [goedgekeurdDoorId], references: [id], onDelete: SetNull)

  opmerking String?

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([medewerkerId])
  @@index([goedgekeurd])
}
/// ======================================================
/// PRODUCTEN
/// ======================================================

model ProductCategorie {
  id String @id @default(cuid())

  naam String @unique

  omschrijving String?

  volgorde Int @default(0)

  actief Boolean @default(true)

  producten Product[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([actief])
}

model Leverancier {
  id String @id @default(cuid())

  naam String @unique

  code String? @unique

  contactpersoon String?

  email String?

  telefoon String?

  adres String?

  postcode String?

  plaats String?

  actief Boolean @default(true)

  producten Product[]
  bestellingen LeverancierBestelling[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([actief])
}

model Product {
  id String @id @default(cuid())

  categorieId String
  categorie ProductCategorie @relation(fields: [categorieId], references: [id], onDelete: Restrict)

  leverancierId String?
  leverancier Leverancier? @relation(fields: [leverancierId], references: [id], onDelete: SetNull)

  code String? @unique

  naam String

  omschrijving String?

  type String

  bestelEenheid String?

  bestelAantal Int @default(1)

  buffer Int @default(0)

  minimumVoorraad Int @default(0)

  maximumVoorraad Int?

  vitrineProduct Boolean @default(false)

  seizoensProduct Boolean @default(false)

  bestelbaar Boolean @default(true)

  actief Boolean @default(true)

  volgorde Int @default(0)

  buffers ProductBuffer[]

  bestelregels BestellingRegel[]

  voorraadMutaties VoorraadMutatie[]
  leverancierBestellingRegels LeverancierBestellingRegel[]
  voorraadTellingRegels VoorraadTellingRegel[]
  aiAdviesRegels AIBestelAdviesRegel[]
  leveringRegels LeveringRegel[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@unique([categorieId, naam])

  @@index([categorieId])
  @@index([leverancierId])
  @@index([type])
  @@index([actief])
}

model ProductBuffer {
  id String @id @default(cuid())

  vestigingId String
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  buffer Int @default(0)

  minimum Int @default(0)

  maximum Int @default(0)

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@unique([vestigingId, productId])

  @@index([vestigingId])
  @@index([productId])
}

/// ======================================================
/// BESTELLINGEN
/// ======================================================

model Bestelling {
  id String @id @default(cuid())

  vestigingId String
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Restrict)

  gebruikerId String?
  gebruiker Gebruiker? @relation(fields: [gebruikerId], references: [id], onDelete: SetNull)

  besteldatum DateTime

  status String @default("Concept")

  opmerking String?

  regels BestellingRegel[]
  aiAdviezen AIBestelAdvies[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([vestigingId])
  @@index([besteldatum])
  @@index([status])
}

model BestellingRegel {
  id String @id @default(cuid())

  bestellingId String
  bestelling Bestelling @relation(fields: [bestellingId], references: [id], onDelete: Cascade)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  geteld Int

  buffer Int

  besteld Int

  opmerking String?

  aangemaaktOp DateTime @default(now())

  @@unique([bestellingId, productId])

  @@index([bestellingId])
  @@index([productId])
}
/// ======================================================
/// PLANNING
/// ======================================================

model Week {
  id String @id @default(cuid())

  vestigingId String
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  jaar Int
  week Int

  afgesloten Boolean @default(false)

  afgeslotenOp DateTime?

  taken WeekTaak[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@unique([vestigingId, jaar, week])

  @@index([vestigingId])
  @@index([jaar])
  @@index([week])
}

model WeekTaak {
  id String @id @default(cuid())

  weekId String
  week Week @relation(fields: [weekId], references: [id], onDelete: Cascade)

  titel String

  categorie String?

  omschrijving String?

  prioriteit String? @default("Normaal")

  voltooid Boolean @default(false)

  voltooidDoorId String?
  voltooidDoor Gebruiker? @relation(fields: [voltooidDoorId], references: [id], onDelete: SetNull)

  voltooidOp DateTime?

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([weekId])
  @@index([voltooid])
}

/// ======================================================
/// VOORRAAD
/// ======================================================

model VoorraadMutatie {
  id String @id @default(cuid())

  vestigingId String
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  gebruikerId String?
  gebruiker Gebruiker? @relation(fields: [gebruikerId], references: [id], onDelete: SetNull)

  type String

  aantal Decimal @db.Decimal(10,2)

  voorraadVoor Int?

  voorraadNa Int?

  opmerking String?

  aangemaaktOp DateTime @default(now())

  @@index([vestigingId])
  @@index([productId])
  @@index([type])
}

/// ======================================================
/// DOCUMENTEN
/// ======================================================

model Document {
  id String @id @default(cuid())

  vestigingId String
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  gebruikerId String?
  gebruiker Gebruiker? @relation(fields: [gebruikerId], references: [id], onDelete: SetNull)

  naam String

  bestand String

  mimeType String

  grootte Int

  bijlagen Bijlage[]

  categorie String?

  aangemaaktOp DateTime @default(now())

  @@index([vestigingId])
  @@index([categorie])
}

/// ======================================================
/// NOTIFICATIES
/// ======================================================

model Notificatie {
  id String @id @default(cuid())

  gebruikerId String
  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  titel String

  bericht String

  link String?

  gelezen Boolean @default(false)

  gelezenOp DateTime?

  aangemaaktOp DateTime @default(now())

  @@index([gebruikerId])
  @@index([gelezen])
}
/// ======================================================
/// DASHBOARD / KPI
/// ======================================================

model DashboardFavoriet {
  id String @id @default(cuid())

  gebruikerId String
  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  naam String

  url String

  volgorde Int @default(0)

  aangemaaktOp DateTime @default(now())

  @@index([gebruikerId])
}

model DashboardWidget {
  id String @id @default(cuid())

  gebruikerId String
  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  widget String

  kolom Int @default(1)

  volgorde Int @default(0)

  instellingen Json?

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([gebruikerId])
}

/// ======================================================
/// LOGGING
/// ======================================================

model LoginSessie {
  id String @id @default(cuid())

  gebruikerId String
  gebruiker Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  token String @unique

  ipAdres String?

  userAgent String?

  ingelogdOp DateTime @default(now())

  uitgelogdOp DateTime?

  verlooptOp DateTime

  @@index([gebruikerId])
  @@index([verlooptOp])
}

model ApiLog {
  id String @id @default(cuid())

  gebruikerId String?
  gebruiker Gebruiker? @relation(fields: [gebruikerId], references: [id], onDelete: SetNull)

  methode String

  endpoint String

  statusCode Int

  duurMs Int

  ipAdres String?

  aangemaaktOp DateTime @default(now())

  @@index([endpoint])
  @@index([statusCode])
  @@index([aangemaaktOp])
}

/// ======================================================
/// BIJLAGEN
/// ======================================================

model Bijlage {
  id String @id @default(cuid())

  documentId String
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  bestandsNaam String

  opslagPad String

  mimeType String

  grootte Int

  aangemaaktOp DateTime @default(now())

  @@index([documentId])
}

/// ======================================================
/// TAGS
/// ======================================================

model Tag {
  id String @id @default(cuid())

  naam String @unique

  kleur String?

  aangemaaktOp DateTime @default(now())
}
/// ======================================================
/// LEVERANCIERSBESTELLINGEN
/// ======================================================

model LeverancierBestelling {
  id String @id @default(cuid())

  leverancierId String
  leverancier Leverancier @relation(fields: [leverancierId], references: [id], onDelete: Restrict)

  vestigingId String
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Restrict)

  gebruikerId String?
  gebruiker Gebruiker? @relation(fields: [gebruikerId], references: [id], onDelete: SetNull)

  bestelDatum DateTime @default(now())

  gewensteLeverdatum DateTime?

  status String @default("Concept")

  opmerking String?

  regels LeverancierBestellingRegel[]
  leveringen Levering[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([leverancierId])
  @@index([vestigingId])
  @@index([status])
}

model LeverancierBestellingRegel {
  id String @id @default(cuid())

  bestellingId String
  bestelling LeverancierBestelling @relation(fields: [bestellingId], references: [id], onDelete: Cascade)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  aantal Int

  ontvangen Int @default(0)

  opmerking String?

  @@unique([bestellingId, productId])

  @@index([bestellingId])
  @@index([productId])
}

/// ======================================================
/// VOORRAADTELLINGEN
/// ======================================================

model VoorraadTelling {
  id String @id @default(cuid())

  vestigingId String
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  gebruikerId String?
  gebruiker Gebruiker? @relation(fields: [gebruikerId], references: [id], onDelete: SetNull)

  datum DateTime @default(now())

  status String @default("Concept")

  opmerking String?

  regels VoorraadTellingRegel[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([vestigingId])
  @@index([status])
}

model VoorraadTellingRegel {
  id String @id @default(cuid())

  tellingId String
  telling VoorraadTelling @relation(fields: [tellingId], references: [id], onDelete: Cascade)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  systeemAantal Int?

  geteldAantal Int

  verschil Int?

  opmerking String?

  @@unique([tellingId, productId])

  @@index([tellingId])
  @@index([productId])
}
/// ======================================================
/// AI / AUTOMATISERING
/// ======================================================

model AIAdvies {
  id String @id @default(cuid())

  vestigingId String?
  vestiging Vestiging? @relation(fields: [vestigingId], references: [id], onDelete: SetNull)

  gebruikerId String?
  gebruiker Gebruiker? @relation(fields: [gebruikerId], references: [id], onDelete: SetNull)

  type String

  titel String

  vraag String

  antwoord String

  model String?

  tokens Int?

  verwerkingMs Int?

  aangemaaktOp DateTime @default(now())

  @@index([vestigingId])
  @@index([gebruikerId])
  @@index([type])
}

model AIBestelAdvies {
  id String @id @default(cuid())

  bestellingId String
  bestelling Bestelling @relation(fields: [bestellingId], references: [id], onDelete: Cascade)

  aangemaaktOp DateTime @default(now())

  vertrouwen Decimal? @db.Decimal(5,2)

  opmerkingen String?

  regels AIBestelAdviesRegel[]

  @@index([bestellingId])
}

model AIBestelAdviesRegel {
  id String @id @default(cuid())

  adviesId String
  advies AIBestelAdvies @relation(fields: [adviesId], references: [id], onDelete: Cascade)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  huidigAantal Int

  geadviseerdAantal Int

  reden String?

  @@unique([adviesId, productId])

  @@index([adviesId])
  @@index([productId])
}

/// ======================================================
/// SYSTEEM
/// ======================================================

model SysteemTaak {
  id String @id @default(cuid())

  naam String

  omschrijving String?

  status String @default("Actief")

  laatsteUitvoering DateTime?

  volgendeUitvoering DateTime?

  foutmelding String?

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([status])
}

model SysteemMelding {
  id String @id @default(cuid())

  niveau String

  titel String

  bericht String

  opgelost Boolean @default(false)

  opgelostOp DateTime?

  aangemaaktOp DateTime @default(now())

  @@index([niveau])
  @@index([opgelost])
}
/// ======================================================
/// EXPORTS / IMPORTS
/// ======================================================

model ImportTaak {
  id String @id @default(cuid())

  vestigingId String?
  vestiging Vestiging? @relation(fields: [vestigingId], references: [id], onDelete: SetNull)

  gebruikerId String?
  gebruiker Gebruiker? @relation(fields: [gebruikerId], references: [id], onDelete: SetNull)

  type String

  bestandsNaam String

  status String @default("InBehandeling")

  totaalRegels Int?

  verwerkt Int?

  fouten Int?

  log String?

  aangemaaktOp DateTime @default(now())
  afgerondOp DateTime?

  @@index([status])
  @@index([type])
}

model ExportTaak {
  id String @id @default(cuid())

  gebruikerId String?
  gebruiker Gebruiker? @relation(fields: [gebruikerId], references: [id], onDelete: SetNull)

  type String

  formaat String

  bestandsNaam String?

  status String @default("InBehandeling")

  aangemaaktOp DateTime @default(now())
  afgerondOp DateTime?

  @@index([status])
  @@index([type])
}

/// ======================================================
/// DASHBOARD
/// ======================================================

model DashboardMelding {
  id String @id @default(cuid())

  vestigingId String?
  vestiging Vestiging? @relation(fields: [vestigingId], references: [id], onDelete: SetNull)

  titel String

  bericht String

  niveau String @default("Info")

  zichtbaarVanaf DateTime?

  zichtbaarTot DateTime?

  actief Boolean @default(true)

  aangemaaktOp DateTime @default(now())

  @@index([actief])
  @@index([niveau])
}

/// ======================================================
/// VERSIES
/// ======================================================

model ReleaseNote {
  id String @id @default(cuid())

  versie String @unique

  titel String

  omschrijving String

  gepubliceerdOp DateTime @default(now())

  zichtbaar Boolean @default(true)

  @@index([zichtbaar])
}

/// ======================================================
/// BACK-UPS
/// ======================================================

model BackupLog {
  id String @id @default(cuid())

  type String

  status String

  bestand String?

  grootteMb Decimal? @db.Decimal(10,2)

  duurSeconden Int?

  foutmelding String?

  aangemaaktOp DateTime @default(now())

  @@index([status])
  @@index([aangemaaktOp])
}
/// ======================================================
/// KASSA / DAGAFSLUITING
/// ======================================================

model DagAfsluiting {
  id String @id @default(cuid())

  vestigingId String
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Restrict)

  gebruikerId String?
  gebruiker Gebruiker? @relation(fields: [gebruikerId], references: [id], onDelete: SetNull)

  datum DateTime

  status String @default("Open")

  omzet Decimal? @db.Decimal(12,2)

  pin Decimal? @db.Decimal(12,2)

  contant Decimal? @db.Decimal(12,2)

  cadeaukaarten Decimal? @db.Decimal(12,2)

  verschil Decimal? @db.Decimal(12,2)

  opmerking String?

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  kasTellingen KasTelling[]

  @@unique([vestigingId, datum])
  @@index([vestigingId])
  @@index([datum])
}

model KasTelling {
  id String @id @default(cuid())

  dagAfsluitingId String
  dagAfsluiting DagAfsluiting @relation(fields: [dagAfsluitingId], references: [id], onDelete: Cascade)

  soort String

  verwacht Decimal? @db.Decimal(12,2)

  geteld Decimal @db.Decimal(12,2)

  verschil Decimal? @db.Decimal(12,2)

  opmerking String?

  aangemaaktOp DateTime @default(now())

  @@index([dagAfsluitingId])
}

/// ======================================================
/// LEVERINGEN
/// ======================================================

model Levering {
  id String @id @default(cuid())

  leverancierBestellingId String
  leverancierBestelling LeverancierBestelling @relation(fields: [leverancierBestellingId], references: [id], onDelete: Cascade)

  vestigingId String
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Restrict)

  geleverdOp DateTime @default(now())

  pakbonNummer String?

  gecontroleerd Boolean @default(false)

  gecontroleerdDoorId String?
  gecontroleerdDoor Gebruiker? @relation(fields: [gecontroleerdDoorId], references: [id], onDelete: SetNull)

  opmerking String?

  regels LeveringRegel[]

  aangemaaktOp DateTime @default(now())

  @@index([vestigingId])
  @@index([geleverdOp])
}

model LeveringRegel {
  id String @id @default(cuid())

  leveringId String
  levering Levering @relation(fields: [leveringId], references: [id], onDelete: Cascade)

  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  besteldAantal Int

  geleverdAantal Int

  afwijking Int @default(0)

  opmerking String?

  @@unique([leveringId, productId])

  @@index([leveringId])
  @@index([productId])
}
