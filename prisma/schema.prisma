generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bestelling {
  id         Int      @id @default(autoincrement())
  datum      DateTime
  vestiging  String
  medewerker String?
  type       String
  opmerking  String?
  aangemaakt DateTime @default(now())

  regels BestellingRegel[]
}

model BestellingRegel {
  id Int @id @default(autoincrement())

  bestellingId Int
  bestelling   Bestelling @relation(fields: [bestellingId], references: [id], onDelete: Cascade)

  productId   String
  productNaam String

  geteld  Int
  buffer  Int
  besteld Int

  bestelGroep String
}

model Week {
  id String @id @default(cuid())

  vestiging String
  jaar      Int
  week      Int

  afgesloten   Boolean   @default(false)
  afgeslotenOp DateTime?

  aangemaakt DateTime @default(now())

  taken WeekTaak[]

  @@unique([vestiging, jaar, week])
  @@index([vestiging])
  @@index([jaar, week])
  @@index([afgesloten])
}

model WeekTaak {
  id String @id @default(cuid())

  weekId String
  week   Week @relation(fields: [weekId], references: [id], onDelete: Cascade)

  categorie String
  taak      String

  voltooid   Boolean   @default(false)
  naam       String?
  voltooidOp DateTime?

  aangemaakt DateTime @default(now())

  @@index([weekId])
  @@index([categorie])
  @@index([voltooid])
}

model Medewerker {
  id String @id @default(cuid())

  voornaam String
  achternaam String

  naam String

  email String?
  telefoon String?

  vestiging String

  actief Boolean @default(true)

  kleur String? @default("#2563eb")

  aangemaakt DateTime @default(now())

  beschikbaarheden Beschikbaarheid[]
  diensten Dienst[]
  uren UurRegistratie[]

  @@index([vestiging])
  @@index([actief])
}

model Beschikbaarheid {
  id String @id @default(cuid())

  medewerkerId String
  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)

  weekdag Int

  beschikbaar Boolean @default(true)

  vanaf String?
  tot String?

  @@index([medewerkerId])
}

model Dienst {
  id String @id @default(cuid())

  medewerkerId String
  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)

  datum DateTime

  begintijd String
  eindtijd String

  vestiging String

  functie String?

  aangemaakt DateTime @default(now())

  urenregistratie UurRegistratie?

  @@index([datum])
  @@index([vestiging])
  @@index([medewerkerId])
}

model UurRegistratie {
  id String @id @default(cuid())

  dienstId String @unique
  dienst Dienst @relation(fields: [dienstId], references: [id], onDelete: Cascade)

  medewerkerId String
  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)

  geplandeStart String
  geplandeEinde String

  gewerkteStart String?
  gewerkteEinde String?

  pauze Int @default(0)

  opmerking String?

  goedgekeurd Boolean @default(false)

  @@index([medewerkerId])
}